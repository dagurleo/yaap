{
  "name": "@yaap/web",
  "version": "0.0.1",
  "license": "Elastic-2.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "email:dev": "email dev --dir src/emails --port 3001",
    "dev": "vite --port 8790 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed": "node scripts/seed-site.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config ../../wrangler.jsonc",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run check:format:backend && npm run build && npm run typecheck && npm run test && npm run check:deploy",
    "preview": "vite preview --port 8790 --strictPort",
    "check:deploy": "node scripts/check-deploy.mjs",
    "db:rollup:local": "node scripts/rollup-local.mjs",
    "db:rollup:postgres": "node scripts/rollup-postgres.mjs",
    "db:generate:postgres": "drizzle-kit generate --config drizzle.postgres.config.ts",
    "db:migrate:postgres": "node scripts/migrate-postgres.mjs",
    "test:postgres": "YAAP_TEST_DATABASE=postgres node --test tests/billing.test.mjs tests/pipeline.test.mjs tests/funnel-runtime.test.mjs tests/public-api.test.mjs",
    "db:setup:postgres": "node scripts/setup-postgres.mjs",
    "test:hyperdrive": "YAAP_TEST_DATABASE=postgres YAAP_TEST_HYPERDRIVE=1 node --test tests/billing.test.mjs tests/pipeline.test.mjs tests/public-api.test.mjs",
    "format:backend": "prettier --write \"src/{api,http,ingest,rate-limit,server,types,visitor-metadata}.ts\" \"src/{auth,db,lib,public-api,server}/**/*.ts\" \"src/emails/**/*.tsx\" src/features/dashboard/functions.ts \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "check:format:backend": "prettier --check \"src/{api,http,ingest,rate-limit,server,types,visitor-metadata}.ts\" \"src/{auth,db,lib,public-api,server}/**/*.ts\" \"src/emails/**/*.tsx\" src/features/dashboard/functions.ts \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "prebuild": "node ../../packages/client/scripts/build.mjs && node scripts/sync-client.mjs",
    "predev": "node ../../packages/client/scripts/build.mjs && node scripts/sync-client.mjs",
    "db:setup:local": "node scripts/setup-local.mjs"
  },
  "cloudflare": {
    "bindings": {
      "EMAIL": {
        "description": "Sends transactional emails through Cloudflare Email Service. Onboard your sender domain and set EMAIL_FROM before use."
      },
      "BILLING_ALERT_EMAIL": {
        "description": "Hosted mode only. Receives operational notices when customer trials end."
      },
      "POLAR_ACCESS_TOKEN": {
        "description": "Hosted mode only. Polar organization access token for the configured environment."
      },
      "POLAR_WEBHOOK_SECRET": {
        "description": "Hosted mode only. Verifies Polar webhook request signatures."
      },
      "DB": {
        "description": "Stores owner sessions, websites, and analytics events."
      },
      "EVENTS": {
        "description": "Buffers incoming analytics events for processing."
      },
      "BETTER_AUTH_SECRET": {
        "description": "Generate with `openssl rand -hex 32`. Keep this secret stable across deployments."
      },
      "BOOTSTRAP_SECRET": {
        "description": "Generate a second value with `openssl rand -hex 32`. Save it to create the owner at /setup after deployment."
      },
      "EVENTS_DLQ": {
        "description": "Holds events that exhausted delivery retries for operator inspection and replay."
      }
    }
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/workers-types": "5.20260908.1",
    "@iconify-json/circle-flags": "^1.2.10",
    "@iconify-json/logos": "^1.2.14",
    "@react-email/ui": "6.9.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@yaap/client": "0.1.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "miniflare": "5.20260908.0-alpha",
    "prettier": "3.9.6",
    "seroval": "^1.6.7",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "wrangler": "4.130.0"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@polar-sh/sdk": "0.49.0",
    "@tanstack/charts": "0.18.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.50",
    "better-auth": "1.7.3",
    "bowser": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.43.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-email": "6.9.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.3.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dagurleo/yaap.git",
    "directory": "apps/web"
  },
  "homepage": "https://github.com/dagurleo/yaap#readme",
  "bugs": {
    "url": "https://github.com/dagurleo/yaap/issues"
  }
}
