{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yaap",
  "main": "apps/web/src/server.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  // Optional Cloudflare Builds variable: YAAP_PLACEMENT_REGION (e.g. aws:us-east-2).
  // npm run build sets placement.region when provided; unset keeps the default.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/payments/*",
      "/ingest",
      "/health",
      "/mcp",
      "/oauth/*",
      "/.well-known/oauth-*",
    ],
  },
  // Optional Cloudflare Builds variable: YAAP_HYPERDRIVE_ID.
  // npm run build replaces DB with HYPERDRIVE and selects Postgres when set.
  // DATABASE_URL belongs in a build secret for migrations, never in this file.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "os-analytics",
      "database_id": "",
      "migrations_dir": "apps/web/migrations",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "os-analytics-events",
      },
      {
        "binding": "EVENTS_DLQ",
        "queue": "os-analytics-dead-letter",
      },
    ],
    "consumers": [
      {
        "queue": "os-analytics-events",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "os-analytics-dead-letter",
        "max_concurrency": 1,
      },
    ],
  },
  "triggers": {
    "crons": ["* * * * *", "17 * * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "workers_dev": true,
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "BOOTSTRAP_SECRET"],
  },
}
